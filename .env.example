# Kitchen Memory configuration.
# Copy to .env and fill values locally. .env is git-ignored; never commit it.

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ESP32 Wi-Fi credentials. Never print or commit the password.
# Copy this file to .env locally and fill the real values there.
WIFI_SSID=
WIFI_PASSWORD=

# Narrated kitchen walkthrough video (kept local; not in the repository).
MAPPING_VIDEO_PATH=./walkthrough.mp4

# -------------------------------------------------------------------------
# Live visual reasoning (scripts/live_kitchen_vlm.py)
# -------------------------------------------------------------------------
# VLM_BACKEND selects the vision engine:
#   claude -> Anthropic vision API. Fast, high quality. Uploads camera frames
#             to Anthropic (NOT local-only). Requires ANTHROPIC_API_KEY below.
#   local  -> SmolVLM2-500M on this laptop. Slower, lower quality, fully private.
VLM_BACKEND=claude

# Anthropic API key for claude backend. Keep it only here (git-ignored) or in the
# shell. Never commit it, print it, or paste it into chat/logs.
ANTHROPIC_API_KEY=

# Claude vision model id. A Sonnet-class model is recommended for live per-frame
# use (faster/cheaper); use an Opus model only for one-off high-quality passes.
VLM_CLAUDE_MODEL=claude-3-5-sonnet-latest

# -------------------------------------------------------------------------
# Agent 3 - reasoning brain (NVIDIA Nemotron, free OpenAI-compatible endpoint)
# Used by the voice assistant and the dashboard "Ask the assistant" chat to
# answer general questions, using local vision + kitchen facts as context.
# Camera frames are NOT sent here (text-only); only the SmolVLM2 scene text is.
# -------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# -------------------------------------------------------------------------
# Greeting and person detection (server/presence.py)
# -------------------------------------------------------------------------
USER_NAME=Leela
PRESENCE_ENABLED=1
PRESENCE_AUTO_LISTEN=1
PRESENCE_GREET_COOLDOWN_S=90
PRESENCE_ABSENT_RESET_S=30

# Laptop text-to-speech (Windows SAPI)
TTS_RATE=165
TTS_VOLUME=1.0
TTS_VOICE=
